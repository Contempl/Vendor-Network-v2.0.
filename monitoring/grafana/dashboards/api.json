                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(rate(http_server_request_duration_seconds_count{service_name=\"VendorNetwork.Api\"}[5m]))",
                                           "legendFormat":  "{{state}}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
